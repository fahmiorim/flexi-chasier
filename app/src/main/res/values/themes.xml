<resources>
    <!-- Tema dasar aplikasi Flexi Cashier (Mode Terang).
         Menggunakan Material 3 sebagai basis desain untuk tampilan yang modern. -->
    <style name="Theme.FlexiKasir" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Menjadikan status bar dan navigation bar transparan untuk mendukung Edge-to-Edge. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Memastikan ikon di status bar terlihat jelas (gelap) pada latar belakang terang. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Tema Splash Screen (Android 12+ API) -->
    <style name="Theme.FlexiKasir.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.FlexiKasir</item>
    </style>
</resources>
